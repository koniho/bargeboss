require "json"
import("./ios.rb")

def play_upload_options(root)
  credentials = ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON", "")
  begin
    key = JSON.parse(credentials)
  rescue JSON::ParserError
    UI.user_error!("Set GOOGLE_PLAY_SERVICE_ACCOUNT_JSON to a service-account JSON key")
  end
  unless key.is_a?(Hash) && key["type"] == "service_account" && key["client_email"] && key["private_key"]
    UI.user_error!("Google Play credentials must be a service-account JSON key")
  end
  status = ENV.fetch("PLAY_RELEASE_STATUS", "draft")
  UI.user_error!("Play status must be draft or completed") unless %w[draft completed].include?(status)
  aab = File.join(root, "build/BargeBoss.aab")
  UI.user_error!("Build the signed BargeBoss.aab first") unless File.file?(aab)
  {
    package_name: "com.bargeboss.game", json_key_data: credentials, aab: aab,
    track: "internal", release_status: status,
    skip_upload_apk: true, skip_upload_metadata: true,
    skip_upload_images: true, skip_upload_screenshots: true, skip_upload_changelogs: true
  }
end

platform :android do
  desc "Upload an existing signed bundle to internal testing only; defaults to draft"
  lane :internal do
    upload_to_play_store(**play_upload_options(File.expand_path("..", __dir__)))
  end
end
